      <!-- ========== ВКЛАДКА 2: МОНИТОРИНГ (ТЗ v1 §4.2) ========== -->
      <widget class="QWidget" name="tabMonitor">
       <attribute name="title"><string>Мониторинг</string></attribute>
       <layout class="QVBoxLayout" name="monitorLayout">
        <item>
         <widget class="QGroupBox" name="groupMonCtrl">
          <property name="title"><string/></property>
          <layout class="QVBoxLayout" name="monCtrlLayout">
           <!-- Единая сетка: чекбоксы (ряд 0) + Период/Окно справа; ряд 1 —
                Старт | 3 индикатора температуры (под T-чекбоксами, НЕ двигать)
                | Очистить | CSV; ряд 2 — Стоп | Пауза | Старт стенда | обороты.
                Одна сетка ⇒ индикаторы column-align с T-чекбоксами и стоят
                между Стартом и Очисткой. Хвостовая распорка (col 7) прижимает
                всё влево. -->
           <item>
            <layout class="QGridLayout" name="monTopGrid">
             <item row="0" column="0"><widget class="QCheckBox" name="chkAcc"><property name="text"><string>Acc</string></property><property name="checked"><bool>true</bool></property></widget></item>
             <item row="0" column="1"><widget class="QCheckBox" name="chkGyro"><property name="text"><string>Gyro</string></property><property name="checked"><bool>true</bool></property></widget></item>
             <item row="0" column="2"><widget class="QCheckBox" name="chkTLsm"><property name="text"><string>T(LSM)</string></property></widget></item>
             <item row="0" column="3"><widget class="QCheckBox" name="chkTTmp"><property name="text"><string>T(TMP117)</string></property></widget></item>
             <item row="0" column="4"><widget class="QCheckBox" name="chkTStm"><property name="text"><string>T(STM32)</string></property></widget></item>
             <item row="0" column="6">
              <widget class="QFrame" name="frameMonPeriod">
               <layout class="QHBoxLayout" name="monPeriodLayout">
                <property name="leftMargin"><number>6</number></property>
                <property name="rightMargin"><number>6</number></property>
                <property name="topMargin"><number>2</number></property>
                <property name="bottomMargin"><number>2</number></property>
                <property name="spacing"><number>6</number></property>
                <item><widget class="QLabel" name="lblPollPeriodCaption"><property name="text"><string>Период:</string></property></widget></item>
                <item>
                 <widget class="QComboBox" name="cmbPollPeriod">
                  <item><property name="text"><string>50 мс</string></property></item>
                  <item><property name="text"><string>100 мс</string></property></item>
                  <item><property name="text"><string>200 мс</string></property></item>
                  <item><property name="text"><string>500 мс</string></property></item>
                  <item><property name="text"><string>1000 мс</string></property></item>
                  <item><property name="text"><string>5000 мс</string></property></item>
                 </widget>
                </item>
               </layout>
              </widget>
             </item>
             <item row="0" column="7">
              <widget class="QFrame" name="frameMonWindow">
               <layout class="QHBoxLayout" name="monWindowLayout">
                <property name="leftMargin"><number>6</number></property>
                <property name="rightMargin"><number>6</number></property>
                <property name="topMargin"><number>2</number></property>
                <property name="bottomMargin"><number>2</number></property>
                <property name="spacing"><number>6</number></property>
                <item><widget class="QLabel" name="lblTimeWindowCaption"><property name="text"><string>Окно:</string></property></widget></item>
                <item>
                 <widget class="QComboBox" name="cmbTimeWindow">
                  <item><property name="text"><string>10 с</string></property></item>
                  <item><property name="text"><string>30 с</string></property></item>
                  <item><property name="text"><string>60 с</string></property></item>
                  <item><property name="text"><string>300 с</string></property></item>
                 </widget>
                </item>
               </layout>
              </widget>
             </item>

             <item row="1" column="0" colspan="2"><widget class="QPushButton" name="btnMonStart"><property name="text"><string>▶ Старт</string></property></widget></item>
             <item row="1" column="2"><widget class="QLabel" name="lblMonTLsm"><property name="text"><string> </string></property><property name="alignment"><set>Qt::AlignCenter</set></property><property name="sizePolicy"><sizepolicy hsizetype="Preferred" vsizetype="Fixed"><horstretch>0</horstretch><verstretch>0</verstretch></sizepolicy></property></widget></item>
             <item row="1" column="3"><widget class="QLabel" name="lblMonTTmp"><property name="text"><string> </string></property><property name="alignment"><set>Qt::AlignCenter</set></property><property name="sizePolicy"><sizepolicy hsizetype="Preferred" vsizetype="Fixed"><horstretch>0</horstretch><verstretch>0</verstretch></sizepolicy></property></widget></item>
             <item row="1" column="4"><widget class="QLabel" name="lblMonTStm"><property name="text"><string> </string></property><property name="alignment"><set>Qt::AlignCenter</set></property><property name="sizePolicy"><sizepolicy hsizetype="Preferred" vsizetype="Fixed"><horstretch>0</horstretch><verstretch>0</verstretch></sizepolicy></property></widget></item>
             <item row="1" column="6"><widget class="QPushButton" name="btnMonClear"><property name="text"><string>Очистить</string></property></widget></item>
             <item row="1" column="7"><widget class="QPushButton" name="btnMonCsv"><property name="text"><string>CSV…</string></property></widget></item>

             <item row="2" column="0"><widget class="QPushButton" name="btnMonStop"><property name="text"><string>■ Стоп</string></property></widget></item>
             <item row="2" column="1"><widget class="QPushButton" name="btnMonPause"><property name="text"><string>⏸ Пауза</string></property></widget></item>
             <item row="2" column="6">
              <widget class="QPushButton" name="btnMonStendStart">
               <property name="text"><string>Старт стенда</string></property>
               <property name="toolTip"><string>Запустить программу циклограммы (параметры вкладки «Стенд») без увода регистратора из сервиса — двигатель работает по программе, датчик наблюдаем на графиках</string></property>
              </widget>
             </item>
             <item row="2" column="7">
              <widget class="QLabel" name="lblMonStendSpeed">
               <property name="text"><string> </string></property>
               <property name="alignment"><set>Qt::AlignCenter</set></property>
               <property name="sizePolicy">
                <sizepolicy hsizetype="Maximum" vsizetype="Fixed">
                 <horstretch>0</horstretch>
                 <verstretch>0</verstretch>
                </sizepolicy>
               </property>
               <property name="minimumWidth"><number>70</number></property>
              </widget>
             </item>

             <item row="0" column="5" rowspan="3"><spacer name="monGridSpacer"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>1</height></size></property></spacer></item>
            </layout>
           </item>
          </layout>
         </widget>
        </item>
        <!-- График температур убран (03.07.2026): числовых индикаторов
             достаточно, освободившееся место — двум большим графикам -->
        <item><widget class="QCustomPlot" name="plotAcc"><property name="minimumHeight"><number>170</number></property></widget></item>
        <item><widget class="QCustomPlot" name="plotGyro"><property name="minimumHeight"><number>170</number></property></widget></item>
        <!-- Живой лог «Мониторинга» (07.07.2026): 3 строки (не мельтешит),
             показывает поток IMU/пуши; перенесён по смыслу с «Данных» сюда.
             Высота ограничена — компактное окно внизу, вид грубый (полировка потом). -->
        <item><widget class="QPlainTextEdit" name="logMon"><property name="readOnly"><bool>true</bool></property><property name="maximumHeight"><number>72</number></property></widget></item>
       </layout>
      </widget>

      <!-- ========== ВКЛАДКА: ТЕСТ ПАМЯТИ ========== -->
      <widget class="QWidget" name="tabMemTest">
       <attribute name="title"><string>Тест памяти</string></attribute>
       <layout class="QVBoxLayout" name="memTestLayout">
        <item>
         <widget class="QLabel" name="lblMemHint">
          <property name="wordWrap"><bool>true</bool></property>
          <property name="text"><string>Квалификационный тест: запись шаблона, чтение, сверка, циклы.</string></property>
         </widget>
        </item>
        <item>
         <layout class="QHBoxLayout" name="memTargetLayout">
          <item><widget class="QLabel" name="lblMemTargetCap"><property name="text"><string>Память:</string></property></widget></item>
          <item>
           <widget class="QComboBox" name="cmbMemTarget">
            <item><property name="text"><string>Flash P25Q128 (16 МБ NOR)</string></property></item>
            <item><property name="text"><string>FRAM FM25xx (опционально)</string></property></item>
           </widget>
          </item>
          <item><widget class="QPushButton" name="btnImgRG"><property name="text"><string>Образ RG</string></property><property name="toolTip"><string>Загрузить образ режима Регистратор из файла (.hex, Intel HEX) и записать в Flash</string></property></widget></item>
          <item><widget class="QPushButton" name="btnImgLOG"><property name="text"><string>Образ LOG</string></property><property name="toolTip"><string>Загрузить образ режима Logger из файла (.hex, Intel HEX) и записать в Flash</string></property></widget></item>
          <item><widget class="QPushButton" name="btnMemReadImg"><property name="text"><string>Прочитать</string></property><property name="toolTip"><string>Прочитать Flash[Страница..Страница+Страниц) и показать гекс-дамп справа (поля заполняются автоматически после записи образа)</string></property><property name="enabled"><bool>false</bool></property></widget></item>
         </layout>
        </item>
        <item>
         <layout class="QHBoxLayout" name="memMidLayout">
          <property name="stretch">0,0,1</property>

          <!-- Левый: Параметры / Состояние — фиксированная ширина по содержимому,
               по высоте растягивается до низа колонки (21.07.2026, по просьбе:
               нижний край вровень с «VDD» справа, а не «повисает» посередине). -->
          <item>
           <widget class="QGroupBox" name="groupMemParams">
            <property name="title"><string>Данные</string></property>
            <property name="sizePolicy"><sizepolicy hsizetype="Fixed" vsizetype="Expanding"><horstretch>0</horstretch><verstretch>0</verstretch></sizepolicy></property>
            <property name="maximumSize"><size><width>230</width><height>16777215</height></size></property>
            <layout class="QGridLayout" name="memParamsGrid">
             <property name="leftMargin"><number>8</number></property>
             <property name="topMargin"><number>8</number></property>
             <property name="rightMargin"><number>8</number></property>
             <property name="bottomMargin"><number>8</number></property>
             <property name="horizontalSpacing"><number>12</number></property>
             <property name="verticalSpacing"><number>4</number></property>
             <!-- Расположение записанного образа (факт) — заполняется
                  автоматически после записи «Образ RG/LOG». Подписи
                  («Образ: страниц»/«Образ: начало») сделаны намеренно
                  непохожими на «Страниц»/«Страница» ниже (решение
                  22.06.2026) — раньше обе пары назывались одинаково и
                  визуально путались с параметрами операции (Задать) в
                  строках ниже. Структура ячеек — та же (label | бокс |
                  бокс). С 02.07.2026 обе ячейки живые: «Задать»
                  (lblImgPagesNA/lblImgAddrNA) — план из выбранного файла
                  образа, ставится при старте операции; «Факт» — ход
                  реальной записи (счётчик страниц растёт живьём), по
                  завершении — итоговый диапазон.
                  ⚠ Известное ограничение (не изменено этим решением): эти
                  индикаторы заполняются ТОЛЬКО из памяти текущей сессии
                  LOGLSMW (после записи тестового образа), не из реального
                  опроса чипа — см. «Известные ограничения (TODO)» в
                  CLAUDE.md. -->
             <item row="0" column="0"><widget class="QLabel" name="lblImgPagesCap"><property name="minimumHeight"><number>24</number></property><property name="text"><string>Занято</string></property><property name="toolTip"><string>Задать — занято страниц во Flash по всем операциям (образ, термотест и т.д.), десятичное, живое. Факт — сколько страниц ещё свободно.</string></property></widget></item>
             <item row="0" column="1"><widget class="QLabel" name="lblImgPagesNA"><property name="minimumWidth"><number>50</number></property><property name="maximumWidth"><number>50</number></property><property name="minimumHeight"><number>24</number></property><property name="text"><string> </string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignVCenter</set></property></widget></item>
             <item row="0" column="2"><widget class="QLabel" name="lblImgPages"><property name="minimumWidth"><number>50</number></property><property name="maximumWidth"><number>50</number></property><property name="minimumHeight"><number>24</number></property><property name="text"><string> </string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignVCenter</set></property></widget></item>
             <item row="1" column="0"><widget class="QLabel" name="lblImgAddrCap"><property name="minimumHeight"><number>24</number></property><property name="text"><string>Адрес</string></property><property name="toolTip"><string>Реальный адрес операции (Flash, байты) — образ, термотест и т.д.</string></property></widget></item>
             <item row="1" column="1" colspan="2"><widget class="QLabel" name="lblImgAddr"><property name="minimumWidth"><number>192</number></property><property name="maximumWidth"><number>192</number></property><property name="minimumHeight"><number>24</number></property><property name="text"><string> </string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignVCenter</set></property></widget></item>
             <!-- Заголовки столбцов -->
             <item row="2" column="0"><widget class="QLabel" name="lblHdrProverka"><property name="minimumHeight"><number>24</number></property><property name="text"><string>Проверка</string></property></widget></item>
             <item row="2" column="1"><widget class="QLabel" name="lblHdrSet"><property name="minimumHeight"><number>24</number></property><property name="text"><string>Задать</string></property><property name="alignment"><set>Qt::AlignCenter</set></property></widget></item>
             <item row="2" column="2"><widget class="QLabel" name="lblHdrFact"><property name="minimumHeight"><number>24</number></property><property name="text"><string>Факт</string></property><property name="alignment"><set>Qt::AlignCenter</set></property></widget></item>
             <!-- Байт -->
             <item row="3" column="0"><widget class="QLabel" name="lblTestByteCap"><property name="minimumHeight"><number>24</number></property><property name="text"><string>Байт</string></property></widget></item>
             <item row="3" column="1"><widget class="QLineEdit" name="editTestByte"><property name="minimumWidth"><number>50</number></property><property name="maximumWidth"><number>50</number></property><property name="minimumHeight"><number>24</number></property><property name="text"><string>00</string></property></widget></item>
             <item row="3" column="2"><widget class="QLabel" name="lblCurByte"><property name="minimumWidth"><number>50</number></property><property name="maximumWidth"><number>50</number></property><property name="minimumHeight"><number>24</number></property><property name="text"><string> </string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignVCenter</set></property></widget></item>
             <!-- Страниц -->
             <item row="4" column="0"><widget class="QLabel" name="lblPagesCap"><property name="minimumHeight"><number>24</number></property><property name="text"><string>Страниц</string></property></widget></item>
             <item row="4" column="1"><widget class="QSpinBox" name="spinMemPages"><property name="minimumWidth"><number>50</number></property><property name="maximumWidth"><number>50</number></property><property name="minimumHeight"><number>24</number></property><property name="buttonSymbols"><enum>QAbstractSpinBox::NoButtons</enum></property><property name="minimum"><number>1</number></property><property name="maximum"><number>65536</number></property><property name="value"><number>10</number></property></widget></item>
             <item row="4" column="2"><widget class="QLabel" name="lblCurPages"><property name="minimumWidth"><number>50</number></property><property name="maximumWidth"><number>50</number></property><property name="minimumHeight"><number>24</number></property><property name="text"><string> </string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignVCenter</set></property></widget></item>
             <!-- Старт (страница-адрес начала операции) — переименовано из
                  «Страница» 02.07.2026: путалось со строкой «Страниц» выше
                  (количество) — визуально почти одинаковые подписи одна над
                  другой. -->
             <item row="5" column="0"><widget class="QLabel" name="lblStartPageCap"><property name="minimumHeight"><number>24</number></property><property name="text"><string>Старт</string></property></widget></item>
             <item row="5" column="1"><widget class="QSpinBox" name="spinMemStartPage"><property name="minimumWidth"><number>50</number></property><property name="maximumWidth"><number>50</number></property><property name="minimumHeight"><number>24</number></property><property name="buttonSymbols"><enum>QAbstractSpinBox::NoButtons</enum></property><property name="minimum"><number>1</number></property><property name="maximum"><number>65536</number></property><property name="value"><number>1</number></property><property name="toolTip"><string>Номер страницы на экране = внутренний номер + 1 (стр.1 на экране = служебная стр.0 с флагами, стр.2 = первая обычная).</string></property></widget></item>
             <item row="5" column="2"><widget class="QLabel" name="lblCurActivePage"><property name="minimumWidth"><number>50</number></property><property name="maximumWidth"><number>50</number></property><property name="minimumHeight"><number>24</number></property><property name="text"><string> </string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignVCenter</set></property></widget></item>
             <!-- SPI — тип шины (22.07.2026). Реально управляет прошивкой
                  через 0x2B (FLASH_SET_SPI_MODE) — только для ручной проверки
                  в Сервисе. SPIx2 (dual) сознательно исключён — в прошивке
                  есть в enum, но нигде не реализован; понадобится, возможно,
                  только при большом составе периферии в некоторых
                  конфигурациях — доделаем тогда же. -->
             <item row="6" column="0"><widget class="QLabel" name="lblSpiCap"><property name="minimumHeight"><number>24</number></property><property name="text"><string>SPI</string></property></widget></item>
             <item row="6" column="1" colspan="2"><widget class="QComboBox" name="comboSpiMode"><property name="minimumWidth"><number>112</number></property><property name="maximumWidth"><number>112</number></property><property name="minimumHeight"><number>24</number></property><property name="maximumHeight"><number>24</number></property><property name="toolTip"><string>Только для «Проверки» в сервисном режиме — максимальная скорость снятия дампа. «Работа» (испытание) всегда идёт на минимальной частоте/периферии для энергосбережения, тут не участвует.</string></property><item><property name="text"><string>SPI</string></property></item><item><property name="text"><string>SPIx4</string></property></item></widget></item>
             <!-- МГц — частота (22.07.2026: заменено со спин-бокса 1..104 на
                  список реально достижимых значений. Прошивка: HSI без PLL,
                  HCLK = 16 МГц макс (Core/Src/main.c, ServiceClock_Config) —
                  QUADSPI тактируется от HCLK, делитель ClockPrescaler ≥ ÷1,
                  то есть выше 16 МГц физически не бывает. 104 (паспорт чипа
                  P25Q128H) был недостижим на этом MCU — убрано, чтобы не
                  вводить в заблуждение. Список — целые делители 16 МГц.
                  Колонка «Факт» не нужна (по просьбе) — убрана. -->
             <item row="7" column="0"><widget class="QLabel" name="lblSpiMhzCap"><property name="minimumHeight"><number>24</number></property><property name="text"><string>МГц</string></property></widget></item>
