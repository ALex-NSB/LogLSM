           <item><widget class="QPushButton" name="btnFsRead"><property name="text"><string>Прочитать</string></property></widget></item>
           <item><widget class="QPushButton" name="btnFsWrite"><property name="text"><string>Записать</string></property></widget></item>
           <item>
            <spacer name="imuSpacer">
             <property name="orientation"><enum>Qt::Horizontal</enum></property>
             <property name="sizeHint" stdset="0"><size><width>20</width><height>10</height></size></property>
            </spacer>
           </item>
          </layout>
         </widget>
        </item>
        <item>
         <widget class="QGroupBox" name="groupRegister">
          <property name="title"><string>Регистрация</string></property>
          <layout class="QHBoxLayout" name="groupRegisterLayout">
           <item><widget class="QPushButton" name="btnStartRegister"><property name="text"><string>▶ Старт регистрации</string></property></widget></item>
           <item>
            <spacer name="registerSpacer">
             <property name="orientation"><enum>Qt::Horizontal</enum></property>
             <property name="sizeHint" stdset="0"><size><width>20</width><height>10</height></size></property>
            </spacer>
           </item>
          </layout>
         </widget>
        </item>
        <item>
         <spacer name="commandsSpacer">
          <property name="orientation"><enum>Qt::Vertical</enum></property>
          <property name="sizeHint" stdset="0"><size><width>10</width><height>10</height></size></property>
         </spacer>
        </item>
       </layout>
      </widget>

      <!-- ========== ВКЛАДКА 2: МОНИТОРИНГ (ТЗ v1 §4.2) ========== -->
      <widget class="QWidget" name="tabMonitor">
       <attribute name="title"><string>Мониторинг</string></attribute>
       <layout class="QVBoxLayout" name="monitorLayout">
        <item>
         <widget class="QGroupBox" name="groupMonCtrl">
          <property name="title"><string/></property>
          <layout class="QVBoxLayout" name="monCtrlLayout">
           <!-- Единая сетка: чекбоксы (ряд 0) + Период/Окно справа; ряд 1 —
                Старт | 3 индикатора температуры (под T-чекбоксами, НЕ двигать)
                | Очистить | CSV; ряд 2 — Стоп | Пауза | Старт стенда | обороты.
                Одна сетка ⇒ индикаторы column-align с T-чекбоксами и стоят
                между Стартом и Очисткой. Хвостовая распорка (col 7) прижимает
                всё влево. -->
           <item>
            <layout class="QGridLayout" name="monTopGrid">
             <item row="0" column="0"><widget class="QCheckBox" name="chkAcc"><property name="text"><string>Acc</string></property><property name="checked"><bool>true</bool></property></widget></item>
             <item row="0" column="1"><widget class="QCheckBox" name="chkGyro"><property name="text"><string>Gyro</string></property><property name="checked"><bool>true</bool></property></widget></item>
             <item row="0" column="2"><widget class="QCheckBox" name="chkTLsm"><property name="text"><string>T(LSM)</string></property></widget></item>
             <item row="0" column="3"><widget class="QCheckBox" name="chkTTmp"><property name="text"><string>T(TMP117)</string></property></widget></item>
             <item row="0" column="4"><widget class="QCheckBox" name="chkTStm"><property name="text"><string>T(STM32)</string></property></widget></item>
             <item row="0" column="6">
              <widget class="QFrame" name="frameMonPeriod">
               <layout class="QHBoxLayout" name="monPeriodLayout">
                <property name="leftMargin"><number>6</number></property>
                <property name="rightMargin"><number>6</number></property>
                <property name="topMargin"><number>2</number></property>
                <property name="bottomMargin"><number>2</number></property>
                <property name="spacing"><number>6</number></property>
                <item><widget class="QLabel" name="lblPollPeriodCaption"><property name="text"><string>Период:</string></property></widget></item>
                <item>
                 <widget class="QComboBox" name="cmbPollPeriod">
                  <item><property name="text"><string>50 мс</string></property></item>
                  <item><property name="text"><string>100 мс</string></property></item>
                  <item><property name="text"><string>200 мс</string></property></item>
                  <item><property name="text"><string>500 мс</string></property></item>
                  <item><property name="text"><string>1000 мс</string></property></item>
                  <item><property name="text"><string>5000 мс</string></property></item>
                 </widget>
                </item>
               </layout>
              </widget>
             </item>
             <item row="0" column="7">
              <widget class="QFrame" name="frameMonWindow">
               <layout class="QHBoxLayout" name="monWindowLayout">
                <property name="leftMargin"><number>6</number></property>
                <property name="rightMargin"><number>6</number></property>
                <property name="topMargin"><number>2</number></property>
                <property name="bottomMargin"><number>2</number></property>
                <property name="spacing"><number>6</number></property>
                <item><widget class="QLabel" name="lblTimeWindowCaption"><property name="text"><string>Окно:</string></property></widget></item>
                <item>
                 <widget class="QComboBox" name="cmbTimeWindow">
                  <item><property name="text"><string>10 с</string></property></item>
                  <item><property name="text"><string>30 с</string></property></item>
                  <item><property name="text"><string>60 с</string></property></item>
                  <item><property name="text"><string>300 с</string></property></item>
                 </widget>
                </item>
               </layout>
              </widget>
             </item>

             <item row="1" column="0" colspan="2"><widget class="QPushButton" name="btnMonStart"><property name="text"><string>▶ Старт</string></property></widget></item>
             <item row="1" column="2"><widget class="QLabel" name="lblMonTLsm"><property name="text"><string> </string></property><property name="alignment"><set>Qt::AlignCenter</set></property><property name="sizePolicy"><sizepolicy hsizetype="Preferred" vsizetype="Fixed"><horstretch>0</horstretch><verstretch>0</verstretch></sizepolicy></property></widget></item>
             <item row="1" column="3"><widget class="QLabel" name="lblMonTTmp"><property name="text"><string> </string></property><property name="alignment"><set>Qt::AlignCenter</set></property><property name="sizePolicy"><sizepolicy hsizetype="Preferred" vsizetype="Fixed"><horstretch>0</horstretch><verstretch>0</verstretch></sizepolicy></property></widget></item>
             <item row="1" column="4"><widget class="QLabel" name="lblMonTStm"><property name="text"><string> </string></property><property name="alignment"><set>Qt::AlignCenter</set></property><property name="sizePolicy"><sizepolicy hsizetype="Preferred" vsizetype="Fixed"><horstretch>0</horstretch><verstretch>0</verstretch></sizepolicy></property></widget></item>
             <item row="1" column="6"><widget class="QPushButton" name="btnMonClear"><property name="text"><string>Очистить</string></property></widget></item>
             <item row="1" column="7"><widget class="QPushButton" name="btnMonCsv"><property name="text"><string>CSV…</string></property></widget></item>

             <item row="2" column="0"><widget class="QPushButton" name="btnMonStop"><property name="text"><string>■ Стоп</string></property></widget></item>
             <item row="2" column="1"><widget class="QPushButton" name="btnMonPause"><property name="text"><string>⏸ Пауза</string></property></widget></item>
             <item row="2" column="6">
              <widget class="QPushButton" name="btnMonStendStart">
               <property name="text"><string>Старт стенда</string></property>
               <property name="toolTip"><string>Запустить программу циклограммы (параметры вкладки «Стенд») без увода регистратора из сервиса — двигатель работает по программе, датчик наблюдаем на графиках</string></property>
              </widget>
             </item>
             <item row="2" column="7">
              <widget class="QLabel" name="lblMonStendSpeed">
               <property name="text"><string> </string></property>
               <property name="alignment"><set>Qt::AlignCenter</set></property>
               <property name="sizePolicy">
                <sizepolicy hsizetype="Maximum" vsizetype="Fixed">
                 <horstretch>0</horstretch>
                 <verstretch>0</verstretch>
                </sizepolicy>
               </property>
               <property name="minimumWidth"><number>70</number></property>
              </widget>
             </item>

             <item row="0" column="5" rowspan="3"><spacer name="monGridSpacer"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>1</height></size></property></spacer></item>
            </layout>
           </item>
          </layout>
         </widget>
        </item>
        <!-- График температур убран (03.07.2026): числовых индикаторов
             достаточно, освободившееся место — двум большим графикам -->
        <item><widget class="QCustomPlot" name="plotAcc"><property name="minimumHeight"><number>170</number></property></widget></item>
        <item><widget class="QCustomPlot" name="plotGyro"><property name="minimumHeight"><number>170</number></property></widget></item>
        <!-- Живой лог «Мониторинга» (07.07.2026): 3 строки (не мельтешит),
             показывает поток IMU/пуши; перенесён по смыслу с «Данных» сюда.
             Высота ограничена — компактное окно внизу, вид грубый (полировка потом). -->
        <item><widget class="QPlainTextEdit" name="logMon"><property name="readOnly"><bool>true</bool></property><property name="maximumHeight"><number>72</number></property></widget></item>
       </layout>
      </widget>

      <!-- ========== ВКЛАДКА: ТЕСТ ПАМЯТИ ========== -->
      <widget class="QWidget" name="tabMemTest">
       <attribute name="title"><string>Тест памяти</string></attribute>
       <layout class="QVBoxLayout" name="memTestLayout">
        <item>
         <widget class="QLabel" name="lblMemHint">
          <property name="wordWrap"><bool>true</bool></property>
          <property name="text"><string>Квалификационный тест: запись шаблона, чтение, сверка, циклы.</string></property>
         </widget>
        </item>
        <item>
         <layout class="QHBoxLayout" name="memTargetLayout">
          <item><widget class="QLabel" name="lblMemTargetCap"><property name="text"><string>Память:</string></property></widget></item>
          <item>
           <widget class="QComboBox" name="cmbMemTarget">
            <item><property name="text"><string>Flash P25Q128 (16 МБ NOR)</string></property></item>
            <item><property name="text"><string>FRAM FM25xx (опционально)</string></property></item>
           </widget>
          </item>
          <item><widget class="QPushButton" name="btnImgRG"><property name="text"><string>Образ RG</string></property><property name="toolTip"><string>Загрузить образ режима Регистратор из файла (.hex, Intel HEX) и записать в Flash</string></property></widget></item>
          <item><widget class="QPushButton" name="btnImgLOG"><property name="text"><string>Образ LOG</string></property><property name="toolTip"><string>Загрузить образ режима Logger из файла (.hex, Intel HEX) и записать в Flash</string></property></widget></item>
          <item><widget class="QPushButton" name="btnMemReadImg"><property name="text"><string>Прочитать</string></property><property name="toolTip"><string>Прочитать Flash[Страница..Страница+Страниц) и показать гекс-дамп справа (поля заполняются автоматически после записи образа)</string></property><property name="enabled"><bool>false</bool></property></widget></item>
         </layout>
        </item>
        <item>
         <layout class="QHBoxLayout" name="memMidLayout">
          <property name="stretch">0,0,1</property>

          <!-- Левый: Параметры / Состояние — фиксированная ширина по содержимому -->
          <item>
           <widget class="QGroupBox" name="groupMemParams">
            <property name="title"><string>Параметры / Состояние</string></property>
            <property name="sizePolicy"><sizepolicy hsizetype="Fixed" vsizetype="Preferred"><horstretch>0</horstretch><verstretch>0</verstretch></sizepolicy></property>
            <layout class="QGridLayout" name="memParamsGrid">
             <!-- Расположение записанного образа (факт) — заполняется
                  автоматически после записи «Образ RG/LOG». Подписи
                  («Образ: страниц»/«Образ: начало») сделаны намеренно
                  непохожими на «Страниц»/«Страница» ниже (решение
                  22.06.2026) — раньше обе пары назывались одинаково и
                  визуально путались с параметрами операции (Задать) в
                  строках ниже. Структура ячеек — та же (label | бокс |
                  бокс). С 02.07.2026 обе ячейки живые: «Задать»
                  (lblImgPagesNA/lblImgAddrNA) — план из выбранного файла
                  образа, ставится при старте операции; «Факт» — ход
                  реальной записи (счётчик страниц растёт живьём), по
                  завершении — итоговый диапазон.
                  ⚠ Известное ограничение (не изменено этим решением): эти
                  индикаторы заполняются ТОЛЬКО из памяти текущей сессии
                  LOGLSMW (после записи тестового образа), не из реального
                  опроса чипа — см. «Известные ограничения (TODO)» в
                  CLAUDE.md. -->
             <item row="0" column="0"><widget class="QLabel" name="lblImgPagesCap"><property name="text"><string>Образ: страниц</string></property><property name="toolTip"><string>Количество страниц записанного образа (Образ RG/LOG) — диапазон для «Прочитать». Не параметр операции ниже — отдельный индикатор диапазона тестового образа.</string></property></widget></item>
             <item row="0" column="1"><widget class="QLabel" name="lblImgPagesNA"><property name="text"><string> </string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignVCenter</set></property></widget></item>
             <item row="0" column="2"><widget class="QLabel" name="lblImgPages"><property name="text"><string> </string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignVCenter</set></property></widget></item>
             <item row="1" column="0"><widget class="QLabel" name="lblImgAddrCap"><property name="text"><string>Образ: начало</string></property><property name="toolTip"><string>Начальная страница записанного образа (Образ RG/LOG) — диапазон для «Прочитать». Не параметр операции ниже — отдельный индикатор диапазона тестового образа.</string></property></widget></item>
             <item row="1" column="1"><widget class="QLabel" name="lblImgAddrNA"><property name="text"><string> </string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignVCenter</set></property></widget></item>
             <item row="1" column="2"><widget class="QLabel" name="lblImgAddr"><property name="text"><string> </string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignVCenter</set></property></widget></item>
             <!-- Заголовки столбцов -->
             <item row="2" column="1"><widget class="QLabel" name="lblHdrSet"><property name="text"><string>Задать</string></property><property name="alignment"><set>Qt::AlignCenter</set></property></widget></item>
             <item row="2" column="2"><widget class="QLabel" name="lblHdrFact"><property name="text"><string>Факт</string></property><property name="alignment"><set>Qt::AlignCenter</set></property></widget></item>
             <!-- Байт -->
             <item row="3" column="0"><widget class="QLabel" name="lblTestByteCap"><property name="text"><string>Байт</string></property></widget></item>
             <item row="3" column="1"><widget class="QLineEdit" name="editTestByte"><property name="text"><string>00</string></property></widget></item>
             <item row="3" column="2"><widget class="QLabel" name="lblCurByte"><property name="text"><string> </string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignVCenter</set></property></widget></item>
             <!-- Страниц -->
             <item row="4" column="0"><widget class="QLabel" name="lblPagesCap"><property name="text"><string>Страниц</string></property></widget></item>
             <item row="4" column="1"><widget class="QSpinBox" name="spinMemPages"><property name="minimum"><number>1</number></property><property name="maximum"><number>65536</number></property><property name="value"><number>10</number></property></widget></item>
             <item row="4" column="2"><widget class="QLabel" name="lblCurPages"><property name="text"><string> </string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignVCenter</set></property></widget></item>
             <!-- Старт (страница-адрес начала операции) — переименовано из
                  «Страница» 02.07.2026: путалось со строкой «Страниц» выше
                  (количество) — визуально почти одинаковые подписи одна над
                  другой. -->
             <item row="5" column="0"><widget class="QLabel" name="lblStartPageCap"><property name="text"><string>Старт</string></property></widget></item>
             <item row="5" column="1"><widget class="QSpinBox" name="spinMemStartPage"><property name="maximum"><number>65535</number></property><property name="value"><number>0</number></property></widget></item>
             <item row="5" column="2"><widget class="QLabel" name="lblCurActivePage"><property name="text"><string> </string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignVCenter</set></property></widget></item>
             <!-- SPI МГц -->
             <item row="6" column="0"><widget class="QLabel" name="lblSpiCap"><property name="text"><string>SPI, МГц</string></property></widget></item>
             <item row="6" column="1"><widget class="QSpinBox" name="spinMemSpi"><property name="maximum"><number>104</number></property><property name="value"><number>40</number></property></widget></item>
             <item row="6" column="2"><widget class="QLabel" name="lblCurSpi"><property name="text"><string> </string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignVCenter</set></property></widget></item>
             <!-- Циклов -->
             <item row="7" column="0"><widget class="QLabel" name="lblMemCyclesCap"><property name="text"><string>Циклов</string></property></widget></item>
             <item row="7" column="1"><widget class="QSpinBox" name="spinMemCycles"><property name="maximum"><number>1000000</number></property><property name="value"><number>1</number></property></widget></item>
             <item row="7" column="2"><widget class="QLabel" name="lblCurCycle"><property name="text"><string> </string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignVCenter</set></property></widget></item>
             <!-- Ошибок -->
             <item row="8" column="0"><widget class="QLabel" name="lblErrCap"><property name="text"><string>Ошибок, байт</string></property></widget></item>
             <item row="8" column="1"><widget class="QLabel" name="lblCurStep"><property name="maximumHeight"><number>26</number></property><property name="text"><string> </string></property><property name="alignment"><set>Qt::AlignCenter</set></property></widget></item>
             <item row="8" column="2"><widget class="QLabel" name="lblCurErrors"><property name="maximumHeight"><number>26</number></property><property name="text"><string> </string></property><property name="alignment"><set>Qt::AlignCenter</set></property></widget></item>
            </layout>
           </widget>
          </item>

          <!-- Правый: занимает всё свободное пространство -->
          <item>
           <widget class="QWidget" name="wgtMemRight">
            <property name="sizePolicy"><sizepolicy hsizetype="Fixed" vsizetype="Preferred"><horstretch>0</horstretch><verstretch>0</verstretch></sizepolicy></property>
            <layout class="QVBoxLayout" name="memRightLayout">
             <property name="spacing"><number>6</number></property>
            <item>
             <widget class="QGroupBox" name="groupMemTemp">
              <property name="title"><string>Термотест</string></property>
              <layout class="QVBoxLayout" name="memTempLayout">
               <item>
                <layout class="QHBoxLayout" name="memSens0Layout">
                 <item><widget class="QRadioButton" name="radMemTmp"><property name="text"><string>TMP</string></property><property name="checked"><bool>true</bool></property></widget></item>
                 <item><widget class="QLabel" name="lblMemTmpVal"><property name="text"><string>— °C</string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignVCenter</set></property></widget></item>
                </layout>
               </item>
               <item>
                <layout class="QHBoxLayout" name="memSens1Layout">
                 <item><widget class="QRadioButton" name="radMemLsm"><property name="text"><string>LSM</string></property></widget></item>
                 <item><widget class="QLabel" name="lblMemLsmVal"><property name="text"><string>— °C</string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignVCenter</set></property></widget></item>
                </layout>
               </item>
               <item>
                <layout class="QHBoxLayout" name="memSens2Layout">
                 <item><widget class="QRadioButton" name="radMemStm"><property name="text"><string>STM</string></property></widget></item>
                 <item><widget class="QLabel" name="lblMemStmVal"><property name="text"><string>— °C</string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignVCenter</set></property></widget></item>
                </layout>
               </item>
               <item>
                <layout class="QFormLayout" name="memTempForm">
                 <item row="0" column="0"><widget class="QLabel" name="lblTMaxCap"><property name="text"><string>МАКС °C</string></property></widget></item>
                 <item row="0" column="1"><widget class="QSpinBox" name="spinTMax"><property name="minimum"><number>-50</number></property><property name="maximum"><number>150</number></property><property name="value"><number>85</number></property></widget></item>
                 <item row="1" column="0"><widget class="QLabel" name="lblTMinCap"><property name="text"><string>МИН °C</string></property></widget></item>
                 <item row="1" column="1"><widget class="QSpinBox" name="spinTMin"><property name="minimum"><number>-50</number></property><property name="maximum"><number>150</number></property><property name="value"><number>-20</number></property></widget></item>
                 <item row="2" column="0"><widget class="QLabel" name="lblTStepCap"><property name="text"><string>ШАГ</string></property></widget></item>
                 <item row="2" column="1"><layout class="QHBoxLayout" name="memStepLayout"><property name="spacing"><number>4</number></property><item><widget class="QSpinBox" name="spinTStep"><property name="minimum"><number>1</number></property><property name="maximum"><number>50</number></property><property name="value"><number>5</number></property><property name="suffix"><string> °C</string></property><property name="toolTip"><string>Шаг температуры: операция запускается при изменении на столько градусов</string></property></widget></item><item><widget class="QSpinBox" name="spinTPasses"><property name="minimum"><number>1</number></property><property name="maximum"><number>1000</number></property><property name="value"><number>10</number></property><property name="suffix"><string> стр</string></property><property name="toolTip"><string>Проходов: сколько страниц (от «Старт») записать и сверить на каждой температурной точке</string></property></widget></item></layout></item>
                </layout>
               </item>
               <item>
                <widget class="QPushButton" name="btnTempRun">
                 <property name="text"><string>Старт ▶</string></property>
                </widget>
               </item>
              </layout>
             </widget>
            </item>
            <!-- Питание -->
            <item>
             <widget class="QGroupBox" name="groupMemPower">
              <property name="title"><string>Питание</string></property>
              <layout class="QFormLayout" name="memPowerLayout">
               <item row="0" column="0"><widget class="QLabel" name="lblVddCap"><property name="text"><string>VDD</string></property></widget></item>
               <item row="0" column="1"><widget class="QLabel" name="lblVddVal"><property name="text"><string>— В</string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignVCenter</set></property></widget></item>
               <item row="1" column="0"><widget class="QLabel" name="lblVbatCap"><property name="text"><string>VBAT</string></property></widget></item>
               <item row="1" column="1"><widget class="QLabel" name="lblVbatVal"><property name="text"><string>— В</string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignVCenter</set></property></widget></item>
              </layout>
             </widget>
            </item>
            </layout>
           </widget>
          </item>

          <!-- Гекс-дамп образа (кнопка «Прочитать») -->
          <item>
           <widget class="QFrame" name="frameMemInfo">
            <property name="frameShape"><enum>QFrame::StyledPanel</enum></property>
            <property name="frameShadow"><enum>QFrame::Sunken</enum></property>
            <layout class="QVBoxLayout" name="memInfoLayout">
             <property name="leftMargin"><number>0</number></property>
             <property name="topMargin"><number>0</number></property>
             <property name="rightMargin"><number>0</number></property>
             <property name="bottomMargin"><number>0</number></property>
             <item>
              <widget class="QPlainTextEdit" name="txtHexDump">
               <property name="readOnly"><bool>true</bool></property>
               <property name="lineWrapMode"><enum>QPlainTextEdit::NoWrap</enum></property>
               <property name="placeholderText"><string>Гекс-дамп — кнопка «Прочитать»</string></property>
              </widget>
             </item>
            </layout>
           </widget>
          </item>

         </layout>
        </item>

        <!-- Кнопки операций (вне групп) -->
        <item>
         <layout class="QHBoxLayout" name="memOpsLayout">
          <item><widget class="QPushButton" name="btnMemWrite"><property name="text"><string>Запись</string></property></widget></item>
          <item><widget class="QPushButton" name="btnMemRead"><property name="text"><string>Чтение</string></property></widget></item>
          <item><widget class="QPushButton" name="btnMemErasePage"><property name="text"><string>Страница 0</string></property></widget></item>
          <item><widget class="QPushButton" name="btnMemEraseSector"><property name="text"><string>Сектор 0</string></property></widget></item>
          <item><widget class="QPushButton" name="btnMemEraseChip"><property name="text"><string>Чип</string></property></widget></item>
         </layout>
        </item>

        <!-- Лог -->
        <item>
         <widget class="QPlainTextEdit" name="memReport">
          <property name="readOnly"><bool>true</bool></property>
         </widget>
        </item>

        <item>
         <widget class="QGroupBox" name="groupDevInfo">
          <property name="title"><string>Индивидуальная информация устройства (внутр. Flash STM32)</string></property>
          <layout class="QHBoxLayout" name="devInfoLayout">
           <item><widget class="QLabel" name="lblSerialCap"><property name="text"><string>Серийный №</string></property></widget></item>
           <item><widget class="QLineEdit" name="editSerial"><property name="text"><string>LSMA-0000</string></property></widget></item>
           <item><widget class="QLabel" name="lblVariantCap"><property name="text"><string>Вариант</string></property></widget></item>
           <item>
            <widget class="QComboBox" name="cmbDevVariant">
             <item><property name="text"><string>A (LSM6DSO)</string></property></item>
             <item><property name="text"><string>B (LSM6DSV320X)</string></property></item>
            </widget>
           </item>
           <item><widget class="QLabel" name="lblProdDateCap"><property name="text"><string>Дата выпуска</string></property></widget></item>
           <item><widget class="QLineEdit" name="editProdDate"><property name="text"><string>2026-06-16</string></property></widget></item>
           <item><widget class="QPushButton" name="btnDevInfoRead"><property name="text"><string>Прочитать</string></property></widget></item>
           <item><widget class="QPushButton" name="btnDevInfoWrite"><property name="text"><string>Записать</string></property></widget></item>
          </layout>
         </widget>
        </item>
       </layout>
      </widget>

<!-- ========== ВКЛАДКА: СТЕНД ========== -->
<widget class="QWidget" name="tabStend">
 <attribute name="title"><string>Стенд</string></attribute>
 <layout class="QVBoxLayout" name="tabStendOuterLayout">
  <property name="margin"><number>0</number></property>
  <item>
   <widget class="QScrollArea" name="stendScrollArea">
    <property name="widgetResizable"><bool>true</bool></property>
    <property name="frameShape"><enum>QFrame::NoFrame</enum></property>
    <widget class="QWidget" name="stendScrollContent">
     <layout class="QVBoxLayout" name="stendLayout">
      <!-- Поля вкладки: без них заголовок верхней группы («Циклограмма
           испытания») рисовался в margin-зоне рамки у самого края и
           визуально обрезался (замечено 03.07.2026) -->
      <property name="margin"><number>10</number></property>
      <item>
       <layout class="QHBoxLayout" name="stendTopLayout">
    <item>
     <!-- 03.07.2026, перестройка высот: жёсткие 480px убраны — содержимое
          колонки выросло (Наработка, Память устройства, кнопки офлайн-вида)
          и вылезало за фиксированную рамку. Высота теперь по содержимому;
          правая панель (groupCompare, vsizetype=Expanding) тянется ровно до
          этой же высоты — колонки всегда одинаковые. Общий размер вкладки
          не зависит от масштабирования окна: снизу в stendLayout стоит
          распорка stendBottomSpacer, забирающая лишнюю высоту. -->
     <widget class="QGroupBox" name="groupCyclogram">
      <property name="sizePolicy">
       <sizepolicy hsizetype="Fixed" vsizetype="Preferred">
        <horstretch>0</horstretch>
        <verstretch>0</verstretch>
       </sizepolicy>
      </property>
      <property name="minimumWidth"><number>260</number></property>
      <property name="maximumWidth"><number>260</number></property>
      <property name="title"><string>Циклограмма испытания</string></property>
      <layout class="QVBoxLayout" name="groupCyclogramLayout">
       <property name="spacing"><number>6</number></property>
       <item>
        <layout class="QGridLayout" name="cyclogramGrid">
         <property name="verticalSpacing"><number>4</number></property>
         <property name="horizontalSpacing"><number>4</number></property>
  	<property name="rightMargin"><number>10</number></property>

         
			<item row="1" column="2" colspan="2"><widget class="QLabel" name="lblWorkCap"><property name="alignment"><set>Qt::AlignLeft|Qt::AlignVCenter</set></property><property name="maximumHeight"><number>20</number></property><property name="text"><string>Время работы</string></property></widget></item>
				<item row="2" column="0" colspan="2"><widget class="QLabel" name="lblWorkMinCap"><property name="alignment"><set>Qt::AlignRight|Qt::AlignVCenter</set></property><property name="styleSheet"><string>padding-right: 8px;</string></property><property name="text"><string>Минимум</string></property></widget></item>
