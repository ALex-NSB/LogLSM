         <item row="6" column="0" colspan="2"><widget class="QLabel" name="lblPauseMaxCap"><property name="alignment"><set>Qt::AlignRight|Qt::AlignVCenter</set></property><property name="styleSheet"><string>padding-right: 8px;</string></property><property name="text"><string>Максимум</string></property></widget></item>
         <item row="6" column="2"><widget class="QSpinBox" name="spinPauseMaxMin"><property name="minimumWidth"><number>66</number></property><property name="maximumWidth"><number>66</number></property><property name="buttonSymbols"><enum>QAbstractSpinBox::NoButtons</enum></property><property name="suffix"><string> мин</string></property><property name="maximum"><number>60</number></property><property name="value"><number>0</number></property></widget></item>
