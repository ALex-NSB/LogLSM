         <item row="7" column="2" colspan="2"><widget class="QLabel" name="lblSpdCap"><property name="alignment"><set>Qt::AlignLeft|Qt::AlignVCenter</set></property><property name="maximumHeight"><number>20</number></property><property name="text"><string>Скорость</string></property></widget></item>

         <item row="8" column="0" colspan="2"><widget class="QLabel" name="lblSpdUnitsCap"><property name="alignment"><set>Qt::AlignRight|Qt::AlignVCenter</set></property><property name="styleSheet"><string>padding-right: 8px;</string></property><property name="text"><string>об/мин</string></property></widget></item>
         <item row="8" column="2"><widget class="QSpinBox" name="spinSpdMin"><property name="minimumWidth"><number>66</number></property><property name="maximumWidth"><number>66</number></property><property name="buttonSymbols"><enum>QAbstractSpinBox::NoButtons</enum></property><property name="maximum"><number>666</number></property><property name="value"><number>10</number></property></widget></item>
