            <layout class="QHBoxLayout" name="sensorBtnLayout">
             <item><widget class="QPushButton" name="btnImuRaw"><property name="text"><string>IMU Raw</string></property></widget></item>
             <item><widget class="QPushButton" name="btnTempLsm"><property name="text"><string>Temp LSM</string></property></widget></item>
             <item><widget class="QPushButton" name="btnTempTmp117"><property name="text"><string>Temp TMP117</string></property></widget></item>
