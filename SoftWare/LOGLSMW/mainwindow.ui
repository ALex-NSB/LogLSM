<!-- ========== ВКЛАДКА: СТЕНД ========== -->
<widget class="QWidget" name="tabStend">
 <attribute name="title"><string>Стенд</string></attribute>
 <layout class="QVBoxLayout" name="tabStendOuterLayout">
  <property name="margin"><number>0</number></property>
  <item>
   <widget class="QScrollArea" name="stendScrollArea">
    <property name="widgetResizable"><bool>true</bool></property>
    <property name="frameShape"><enum>QFrame::NoFrame</enum></property>
    <widget class="QWidget" name="stendScrollContent">
     <layout class="QVBoxLayout" name="stendLayout">
      <!-- Поля вкладки: без них заголовок верхней группы («Циклограмма
           испытания») рисовался в margin-зоне рамки у самого края и
           визуально обрезался (замечено 03.07.2026) -->
      <property name="margin"><number>10</number></property>
      <item>
       <layout class="QHBoxLayout" name="stendTopLayout">
    <item>
     <!-- 03.07.2026, перестройка высот: жёсткие 480px убраны — содержимое
          колонки выросло (Наработка, Память устройства, кнопки офлайн-вида)
          и вылезало за фиксированную рамку. Высота теперь по содержимому;
          правая панель (groupCompare, vsizetype=Expanding) тянется ровно до
          этой же высоты — колонки всегда одинаковые. Общий размер вкладки
          не зависит от масштабирования окна: снизу в stendLayout стоит
          распорка stendBottomSpacer, забирающая лишнюю высоту. -->
     <widget class="QGroupBox" name="groupCyclogram">
      <property name="sizePolicy">
       <sizepolicy hsizetype="Fixed" vsizetype="Preferred">
        <horstretch>0</horstretch>
        <verstretch>0</verstretch>
       </sizepolicy>
      </property>
