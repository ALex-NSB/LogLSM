   <item row="3" column="0" colspan="2"><widget class="QLabel" name="lblWorkMaxCap"><property name="alignment"><set>Qt::AlignRight|Qt::AlignVCenter</set></property><property name="styleSheet"><string>padding-right: 8px;</string></property><property name="text"><string>Максимум</string></property></widget></item>
