         <item row="8" column="2"><widget class="QSpinBox" name="spinSpdMin"><property name="minimumWidth"><number>66</number></property><property name="maximumWidth"><number>66</number></property><property name="buttonSymbols"><enum>QAbstractSpinBox::NoButtons</enum></property><property name="maximum"><number>666</number></property><property name="value"><number>10</number></property></widget></item>
         <item row="8" column="3"><widget class="QSpinBox" name="spinSpdMax"><property name="minimumWidth"><number>66</number></property><property name="maximumWidth"><number>66</number></property><property name="buttonSymbols"><enum>QAbstractSpinBox::NoButtons</enum></property><property name="maximum"><number>666</number></property><property name="value"><number>300</number></property></widget></item>

         <item row="9" column="0" colspan="2"><widget class="QLabel" name="lblChgCap"><property name="alignment"><set>Qt::AlignRight|Qt::AlignVCenter</set></property><property name="styleSheet"><string>padding-right: 8px;</string></property><property name="text"><string>интервалов</string></property></widget></item>
         <item row="9" column="2"><widget class="QSpinBox" name="spinChgMin"><property name="minimumWidth"><number>66</number></property><property name="maximumWidth"><number>66</number></property><property name="buttonSymbols"><enum>QAbstractSpinBox::NoButtons</enum></property><property name="minimum"><number>1</number></property><property name="value"><number>1</number></property></widget></item>
         <item row="9" column="3"><widget class="QSpinBox" name="spinChgMax"><property name="minimumWidth"><number>66</number></property><property name="maximumWidth"><number>66</number></property><property name="buttonSymbols"><enum>QAbstractSpinBox::NoButtons</enum></property><property name="minimum"><number>1</number></property><property name="value"><number>1</number></property></widget></item>

         <item row="10" column="0" colspan="4"><widget class="QLabel" name="lblSpdModeCap"><property name="text"><string>Режим</string></property></widget></item>
         <item row="11" column="0" colspan="2"><widget class="QRadioButton" name="radioModeOnlyMinus"><property name="text"><string>Только −</string></property></widget></item>
         <item row="11" column="2" colspan="2"><widget class="QRadioButton" name="radioModeOnlyPlus"><property name="text"><string>Только +</string></property></widget></item>
         <item row="12" column="0" colspan="2"><widget class="QRadioButton" name="radioModeRandom"><property name="text"><string>Случайно ±</string></property></widget></item>
         <item row="12" column="2" colspan="2"><widget class="QRadioButton" name="radioModeNStartStop"><property name="text"><string>N старт/стоп</string></property><property name="checked"><bool>true</bool></property></widget></item>
        </layout>
       </item>
       <item>
        <layout class="QHBoxLayout" name="stendButtonsLayout">
         <property name="spacing"><number>4</number></property>
         <item>
          <widget class="QPushButton" name="btnOpenJournal">
           <property name="text"><string>Журнал</string></property>
           <property name="toolTip"><string>Открыть файл журнала текущего испытания в текстовом редакторе</string></property>
           <property name="enabled"><bool>false</bool></property>
          </widget>
         </item>
         <!-- «Тест» = noReg-циклограмма (то же, что «Старт стенда» на
              «Мониторинге»): регистратор остаётся в Service, графики живые,
              0x1D не шлётся. Текст меняется Тест↔Стоп. -->
         <item>
          <widget class="QPushButton" name="btnStendTest">
           <property name="text"><string>Тест</string></property>
           <property name="toolTip"><string>Прогон циклограммы без увода регистратора из сервиса (только мотор): наблюдаем датчик на «Мониторинге», подбираем ODR/порог Wake-Up</string></property>
          </widget>
         </item>
         <!-- «Работа» = полный тест: 0x1D → регистратор уходит в автомат
              (реальный рабочий режим, Stop2), пуши CMD_CYCLE_PUSH. Текст
              меняется Работа↔Стоп. -->
         <item><widget class="QPushButton" name="btnStendStart"><property name="text"><string>Работа</string></property></widget></item>
         <!-- btnStendStop скрыта: логика объединена с кнопками Тест/Работа -->
         <item><widget class="QPushButton" name="btnStendStop"><property name="text"><string>Стоп</string></property><property name="visible"><bool>false</bool></property></widget></item>
         <!-- Кнопки офлайн-вида («Из устройства…»/«Журнал…») — в группе
              «Память устройства» ниже, не здесь (03.07.2026) -->
        </layout>
       </item>
       <item>
        <widget class="QGroupBox" name="groupUptime">
         <property name="title"><string>Наработка</string></property>
         <layout class="QVBoxLayout" name="uptimeLayout">
          <property name="margin"><number>6</number></property>
          <property name="spacing"><number>4</number></property>
          <item>
           <widget class="QLabel" name="lblFlashStat">
            <property name="text"><string> </string></property>
            <property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property>
            <property name="wordWrap"><bool>false</bool></property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <!-- Часы ПК/регистратора + ⌚ — в СВОБОДНОЙ зоне ниже «Наработки»
            (18.07.2026: к наработке отношения не имеют, тут никому не мешают) -->
       <item>
        <layout class="QHBoxLayout" name="stendTimeLayout">
         <property name="spacing"><number>6</number></property>
         <item>
          <widget class="QLabel" name="lblStendPcTime">
           <property name="text"><string/></property>
           <property name="toolTip"><string>Текущее время ПК</string></property>
          </widget>
         </item>
         <item>
          <widget class="QLabel" name="lblStendDevTime">
           <property name="text"><string/></property>
           <property name="toolTip"><string>Время регистратора (красное = сбито/рассинхрон)</string></property>
          </widget>
         </item>
         <item>
          <spacer name="stendTimeSpacer">
           <property name="orientation"><enum>Qt::Horizontal</enum></property>
           <property name="sizeHint" stdset="0"><size><width>10</width><height>10</height></size></property>
          </spacer>
         </item>
         <item>
          <widget class="QPushButton" name="btnStendSyncTime">
           <property name="text"><string>⌚</string></property>
           <property name="maximumWidth"><number>34</number></property>
           <property name="toolTip"><string>Синхронизировать часы регистратора со временем ПК (SET_DATETIME)</string></property>
          </widget>
         </item>
        </layout>
       </item>
       <!-- «Память устройства» перенесена в правую колонку под панель
            вывода (03.07.2026, запрос: справа — всё про память и её
            содержимое) -->
       <item>
        <spacer name="cyclogramBottomSpacer">
         <property name="orientation"><enum>Qt::Vertical</enum></property>
         <property name="sizeHint" stdset="0"><size><width>20</width><height>40</height></size></property>
        </spacer>
       </item>
      </layout>
     </widget>
    </item>
    <!-- Правая колонка (03.07.2026): всё про память и её содержимое —
         сверху панель вывода/совмещения, снизу «Память устройства» с
         кнопками источников (Память/Образ/Журнал). Левая колонка — только
         управление двигателем и циклограммой. -->
    <item>
     <layout class="QVBoxLayout" name="stendRightColLayout">
      <property name="spacing"><number>8</number></property>
      <item>
     <widget class="QGroupBox" name="groupCompare">
      <!-- Expanding по вертикали: высота = высоте левой колонки (см.
           комментарий у groupCyclogram), жёсткие 480px у cmpReport убраны.
           Expanding по горизонтали (22.07.2026): раньше hsizetype=Fixed
           оставлял пустую полосу справа при фиксированном окне 1200px —
           теперь панель сама занимает освободившееся место. -->
      <property name="sizePolicy">
       <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
        <horstretch>0</horstretch>
        <verstretch>0</verstretch>
       </sizepolicy>
      </property>
      <property name="title"><string></string></property>
      <layout class="QVBoxLayout" name="compareLayout">
       <!-- Закреплённый заголовок колонок (03.07.2026): вынесен из
            прокручиваемого текста cmpReport, чтобы не исчезал при
            скроллинге. Шрифт задаётся в applyStyles тем же kMono 10pt,
            что и cmpReport — колонки совпадают по ширине. Един для
            живого режима и «Из устройства…». -->
       <item>
        <widget class="QLabel" name="lblCmpHeader">
         <property name="text"><string>                 Стенд   Регистратор    Ошибка</string></property>
        </widget>
       </item>
       <item>
        <widget class="QPlainTextEdit" name="cmpReport">
         <property name="readOnly"><bool>true</bool></property>
         <property name="minimumWidth"><number>460</number></property>
         <property name="minimumHeight"><number>300</number></property>
         <property name="lineWrapMode"><enum>QPlainTextEdit::NoWrap</enum></property>
        </widget>
       </item>
       <!-- Кнопки источников офлайн-вида — привязаны к панели вывода cmpReport
            (они наполняют её: Память→Регистратор, Образ/Журнал→Стенд, Очистить).
            Перенесены сюда из «Память устройства» (04.07.2026): та группа —
            только индикатор состояния Flash, не источники вывода. -->
       <item>
        <layout class="QHBoxLayout" name="offlineButtonsLayout">
         <property name="spacing"><number>4</number></property>
         <item>
          <widget class="QPushButton" name="btnStendFromDev">
           <property name="text"><string>Память…</string></property>
           <property name="toolTip"><string>Прочитать записи циклов с Flash регистратора → колонка «Регистратор» (в ней всегда только данные из Flash). Если колонка «Стенд» заполнена (Журнал/Образ) — совмещение и «Ошибка» автоматически</string></property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="btnStendFromImg">
           <property name="text"><string>Образ…</string></property>
           <property name="toolTip"><string>Разобрать записи из файла образа (.hex) → колонка «Стенд» (эталон, или-или с Журналом). Образ + Память = проверка целостности записи: дельты «Ошибки» должны быть нулевые</string></property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="btnStendFromFile">
           <property name="text"><string>Журнал…</string></property>
           <property name="toolTip"><string>Открыть файл журнала испытания → колонка «Стенд» (или-или с Образом). Если прочитана память — совмещение и колонка «Ошибка» автоматически</string></property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="btnStendOfflineClear">
           <property name="text"><string>Очистить</string></property>
           <property name="toolTip"><string>Сбросить офлайн-вид: убрать загруженные записи (Память/Образ) и файл журнала, очистить панель</string></property>
          </widget>
         </item>
        </layout>
       </item>
       <!-- «Память устройства» теперь ВНУТРИ общего правого окна (groupCompare),
            отдельная коробка groupFlashStat убрана (04.07.2026): правое окно одно,
            всё выводится внутри него — вывод сверху, индикатор Flash снизу. -->
       <item>
        <widget class="QLabel" name="lblFlashStatTitle">
         <property name="text"><string>Флеш</string></property>
         <property name="alignment"><set>Qt::AlignHCenter</set></property>
        </widget>
       </item>
       <item>
        <widget class="QProgressBar" name="barFlashMem">
         <property name="minimum"><number>0</number></property>
         <property name="maximum"><number>65535</number></property>
         <property name="value"><number>0</number></property>
         <property name="format"><string>—</string></property>
         <property name="textVisible"><bool>true</bool></property>
         <property name="minimumHeight"><number>22</number></property>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="lblFlashDetail">
         <property name="text"><string></string></property>
         <property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property>
         <property name="wordWrap"><bool>false</bool></property>
        </widget>
       </item>
      </layout>
     </widget>
      </item>
     </layout>
    </item>
    <!-- Горизонтальная распорка: колонки прижаты влево с постоянным зазором,
         лишняя ширина окна уходит сюда (раньше раздавала себя между
         панелями — они «разъезжались» по горизонтали) -->
    <item>
     <spacer name="stendRightSpacer">
      <property name="orientation"><enum>Qt::Horizontal</enum></property>
      <property name="sizeHint" stdset="0"><size><width>8</width><height>20</height></size></property>
     </spacer>
    </item>
   </layout>
  </item>
  <!-- Вертикальная распорка: лишняя высота окна уходит сюда — размер панели
       стабилен, колонки не растут при масштабировании (03.07.2026) -->
  <item>
   <spacer name="stendBottomSpacer">
    <property name="orientation"><enum>Qt::Vertical</enum></property>
    <property name="sizeHint" stdset="0"><size><width>20</width><height>8</height></size></property>
   </spacer>
  </item>
 </layout>
    </widget>
   </widget>
  </item>
 </layout>
</widget>





      <!-- ========== ВКЛАДКА 4: ЛОГ (ТЗ v1 §4.4) ========== -->
      <widget class="QWidget" name="tabLog">
       <attribute name="title"><string>Лог</string></attribute>
       <layout class="QVBoxLayout" name="logTabLayout">
        <item>
         <layout class="QHBoxLayout" name="logCtrlLayout">
          <item>
           <widget class="QComboBox" name="cmbLogFilter">
            <item><property name="text"><string>Все</string></property></item>
            <item><property name="text"><string>TX</string></property></item>
            <item><property name="text"><string>RX</string></property></item>
            <item><property name="text"><string>ERR</string></property></item>
           </widget>
          </item>
          <item><widget class="QLineEdit" name="editLogSearch"><property name="placeholderText"><string>Поиск…</string></property></widget></item>
          <item><widget class="QCheckBox" name="chkAutoScroll"><property name="text"><string>Автопрокрутка</string></property><property name="checked"><bool>true</bool></property></widget></item>
         </layout>
        </item>
        <item><widget class="QPlainTextEdit" name="logView"><property name="readOnly"><bool>true</bool></property></widget></item>
        <item>
         <layout class="QHBoxLayout" name="logBtnLayout">
          <item><widget class="QPushButton" name="btnLogClear"><property name="text"><string>Очистить</string></property></widget></item>
          <item><widget class="QPushButton" name="btnLogSave"><property name="text"><string>Сохранить…</string></property></widget></item>
          <item><widget class="QCheckBox" name="chkHexDump"><property name="text"><string>HEX-дамп пакетов</string></property></widget></item>
          <item>
           <spacer name="logBtnSpacer">
            <property name="orientation"><enum>Qt::Horizontal</enum></property>
            <property name="sizeHint" stdset="0"><size><width>20</width><height>10</height></size></property>
           </spacer>
          </item>
         </layout>
        </item>
       </layout>
      </widget>

      <!-- ========== ВКЛАДКА 5: НАСТРОЙКИ (ТЗ v2 §5.1) ========== -->
      <widget class="QWidget" name="tabSettings">
       <attribute name="title"><string>Настройки</string></attribute>
       <layout class="QFormLayout" name="settingsLayout">
        <item row="0" column="0"><widget class="QLabel" name="lblDevAddrCaption"><property name="text"><string>Адрес устройства (hex)</string></property></widget></item>
        <item row="0" column="1">
         <widget class="QSpinBox" name="spinDevAddr">
          <property name="displayIntegerBase"><number>16</number></property>
          <property name="prefix"><string>0x</string></property>
          <property name="maximum"><number>255</number></property>
          <property name="value"><number>141</number></property>
         </widget>
        </item>
        <item row="1" column="0"><widget class="QLabel" name="lblBaudCaption"><property name="text"><string>Скорость COM</string></property></widget></item>
        <item row="1" column="1">
         <widget class="QComboBox" name="cmbBaud">
          <item><property name="text"><string>921600</string></property></item>
          <item><property name="text"><string>460800</string></property></item>
          <item><property name="text"><string>230400</string></property></item>
          <item><property name="text"><string>115200</string></property></item>
         </widget>
        </item>
        <item row="2" column="0"><widget class="QLabel" name="lblTimeoutCaption"><property name="text"><string>Таймаут ответа, мс</string></property></widget></item>
        <item row="2" column="1"><widget class="QSpinBox" name="spinTimeout"><property name="maximum"><number>10000</number></property><property name="value"><number>500</number></property></widget></item>
        <item row="3" column="0"><widget class="QLabel" name="lblRetriesCaption"><property name="text"><string>Повторы при таймауте</string></property></widget></item>
        <item row="3" column="1"><widget class="QSpinBox" name="spinRetries"><property name="maximum"><number>10</number></property><property name="value"><number>2</number></property></widget></item>
        <item row="4" column="0"><widget class="QLabel" name="lblLogLimitCaption"><property name="text"><string>Лимит лога, строк</string></property></widget></item>
        <item row="4" column="1"><widget class="QSpinBox" name="spinLogLimit"><property name="maximum"><number>100000</number></property><property name="value"><number>5000</number></property></widget></item>
        <item row="5" column="0"><widget class="QLabel" name="lblTimeAlarmCaption"><property name="text"><string>Порог аварии времени, мин</string></property></widget></item>
        <item row="5" column="1"><widget class="QSpinBox" name="spinTimeAlarm"><property name="maximum"><number>1440</number></property><property name="value"><number>10</number></property></widget></item>
        <item row="6" column="0"><widget class="QLabel" name="lblTempSourceCaption"><property name="text"><string>Датчик температуры дашборда</string></property></widget></item>
        <item row="6" column="1">
         <widget class="QComboBox" name="cmbTempSource">
          <item><property name="text"><string>IMU (LSM6DSO)</string></property></item>
          <item><property name="text"><string>TMP117</string></property></item>
          <item><property name="text"><string>STM32</string></property></item>
         </widget>
        </item>
        <!-- Одна папка на все файлы программы: дампы данных, образы, журналы
             испытаний, дальше — реестр приборов (06.08.2026). Раньше здесь была
             неподключённая заготовка «Путь архива». -->
        <item row="7" column="0"><widget class="QLabel" name="lblWorkDirCaption"><property name="text"><string>Рабочая папка</string></property><property name="toolTip"><string>Сюда складываются дампы данных, образы и журналы испытаний</string></property></widget></item>
        <item row="7" column="1">
         <layout class="QHBoxLayout" name="workDirLayout">
          <item><widget class="QLineEdit" name="editWorkDir"><property name="readOnly"><bool>true</bool></property><property name="placeholderText"><string>папка не выбрана</string></property></widget></item>
          <item><widget class="QPushButton" name="btnWorkDirBrowse"><property name="text"><string>…</string></property><property name="maximumWidth"><number>30</number></property></widget></item>
         </layout>
        </item>
        <item row="8" column="0"><widget class="QLabel" name="lblChangeKeyCaption"><property name="text"><string>Ключ сервисного режима</string></property></widget></item>
        <item row="8" column="1"><widget class="QPushButton" name="btnChangeKey"><property name="text"><string>Сменить ключ…</string></property></widget></item>
        <item row="9" column="0"><widget class="QLabel" name="lblRecFormatCaption"><property name="text"><string>Формат записи цикла</string></property></widget></item>
        <item row="9" column="1">
         <widget class="QComboBox" name="cmbRecFormat">
          <item><property name="text"><string>Базовый</string></property></item>
          <item><property name="text"><string>Уплотнённый</string></property></item>
          <item><property name="text"><string>Подробный</string></property></item>
         </widget>
        </item>
       </layout>
      </widget>

      <!-- ========== ВКЛАДКА: КАЛИБРОВКА (заглушка, 11.07.2026) ==========
           Пока без функционала — задел под единую процедуру калибровки:
           часы RTC, коэффициент точной калибровки скорости (усиление
           гироскопа), прочие поэкземплярные параметры; хранение — в
           калибровочном блоке паспорта устройства. См.
           actual/session_notes_2026-07-11_speed_avg_axis_fix.md §10. -->
      <widget class="QWidget" name="tabCalibration">
       <attribute name="title"><string>Калибровка</string></attribute>
       <layout class="QVBoxLayout" name="calibLayout">
        <item>
         <layout class="QGridLayout" name="calibColumns">
            <item row="0" column="0">
             <widget class="QGroupBox" name="groupRtc">
              <property name="maximumWidth"><number>420</number></property>
              <property name="title"><string>Часы RTC</string></property>
              <layout class="QVBoxLayout" name="rtcLayout">
               <item>
                <layout class="QGridLayout" name="rtcGrid">
                 <item row="0" column="0"><widget class="QLabel" name="lblRtcDevCap"><property name="text"><string>Время устройства:</string></property></widget></item>
                 <item row="0" column="1"><widget class="QLabel" name="lblRtcDevTime"><property name="font"><font><family>Consolas</family></font></property><property name="text"><string> </string></property></widget></item>
                 <item row="1" column="0"><widget class="QLabel" name="lblRtcPcCap"><property name="text"><string>Время ПК:</string></property></widget></item>
                 <item row="1" column="1"><widget class="QLabel" name="lblRtcPcTime"><property name="font"><font><family>Consolas</family></font></property><property name="text"><string> </string></property></widget></item>
                 <item row="2" column="0"><widget class="QLabel" name="lblRtcDriftCap"><property name="text"><string>Расхождение:</string></property></widget></item>
                 <item row="2" column="1"><widget class="QLabel" name="lblRtcDrift"><property name="font"><font><family>Consolas</family></font></property><property name="text"><string> </string></property></widget></item>
                 <item row="0" column="2"><spacer name="rtcGridSpacer"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>10</width><height>10</height></size></property></spacer></item>
                </layout>
               </item>
               <item>
                <layout class="QHBoxLayout" name="rtcBtnRow">
                 <item><widget class="QPushButton" name="btnRtcSync"><property name="text"><string>Синхронизировать с ПК</string></property></widget></item>
                </layout>
               </item>
               <item>
                <widget class="Line" name="rtcCalibLine"><property name="orientation"><enum>Qt::Horizontal</enum></property></widget>
               </item>
               <item>
                <widget class="QLabel" name="lblRtcCalHdr"><property name="text"><string>Грубая калибровка дрейфа (по интервалу):</string></property></widget>
               </item>
               <item>
                <layout class="QHBoxLayout" name="rtcCurPpmRow">
                 <item><widget class="QLabel" name="lblRtcCurPpmCap"><property name="text"><string>Поправка:</string></property></widget></item>
                 <item><widget class="QLabel" name="lblRtcCurPpm"><property name="text"><string> </string></property></widget></item>
                 <item><spacer name="rtcCurPpmSpacer"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>10</width><height>10</height></size></property></spacer></item>
                </layout>
               </item>
               <item><widget class="QLabel" name="lblRtcCalStatus"><property name="text"><string>Старт → синхро и отсчёт; выдержка (дольше — точнее); Стоп → расчёт; Применить.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
               <item>
                <layout class="QHBoxLayout" name="rtcCalBtnRow">
                 <item><widget class="QPushButton" name="btnRtcCalStart"><property name="text"><string>Старт</string></property></widget></item>
                 <item><widget class="QPushButton" name="btnRtcCalStop"><property name="text"><string>Стоп</string></property></widget></item>
                 <item><widget class="QPushButton" name="btnRtcCalApply"><property name="text"><string>Применить</string></property><property name="enabled"><bool>false</bool></property></widget></item>
                </layout>
               </item>
               <item><widget class="QPushButton" name="btnRtcCalActStop"><property name="text"><string>Стоп от активации (t0 = момент активации)</string></property></widget></item>
               <item><widget class="QLabel" name="lblRtcNote"><property name="text"><string>Разрешение зависит от выдержки (часы читаются с точностью 1 с): час≈280 ppm, сутки≈12 ppm, неделя≈1.6 ppm. «Стоп от активации» берёт t0 = момент активации (длинный интервал = высокая точность). Суб-ppm — по GPS-PPS (позже).</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
              </layout>
             </widget>
            </item>
            <item row="0" column="1" rowspan="2">
             <widget class="QGroupBox" name="groupSpeedCal">
              <property name="title"><string>Калибровка скорости (таблица узлов, стр.123)</string></property>
              <layout class="QVBoxLayout" name="speedCalLayout">
               <item>
                <widget class="QTableWidget" name="tblSpeedCal">
                 <property name="minimumHeight"><number>260</number></property>
                 <property name="sizePolicy" stdset="0"><sizepolicy hsizetype="Expanding" vsizetype="Expanding"><horstretch>0</horstretch><verstretch>1</verstretch></sizepolicy></property>
                 <property name="columnCount"><number>6</number></property>
                 <column><property name="text"><string>Задано</string></property></column>
                 <column><property name="text"><string>Измерено</string></property></column>
                 <column><property name="text"><string>Текущий</string></property></column>
                 <column><property name="text"><string>Δ изм %</string></property></column>
                 <column><property name="text"><string>Новый</string></property></column>
                 <column><property name="text"><string>Δ расч %</string></property></column>
                </widget>
               </item>
               <item>
                <layout class="QHBoxLayout" name="speedCalCfgRow">
                 <item><widget class="QLabel" name="lblCalDwellCap"><property name="text"><string>Время, с:</string></property></widget></item>
                 <item><widget class="QSpinBox" name="spinCalDwell"><property name="minimum"><number>1</number></property><property name="maximum"><number>120</number></property><property name="value"><number>5</number></property><property name="toolTip"><string>Время измерения на каждой скорости, с.</string></property></widget></item>
                 <item><widget class="QLabel" name="lblCalPauseCap"><property name="text"><string>Пауза, с:</string></property></widget></item>
                 <item><widget class="QSpinBox" name="spinCalPause"><property name="minimum"><number>0</number></property><property name="maximum"><number>60</number></property><property name="value"><number>4</number></property><property name="toolTip"><string>Разгон/пауза перед измерением на каждой скорости, с (можно 0).</string></property></widget></item>
                 <item><widget class="QLabel" name="lblCalCyclesCap"><property name="text"><string>Циклов:</string></property></widget></item>
                 <item><widget class="QSpinBox" name="spinCalCycles"><property name="minimum"><number>1</number></property><property name="maximum"><number>50</number></property><property name="value"><number>1</number></property><property name="toolTip"><string>Сколько раз пройти весь набор скоростей.</string></property></widget></item>
                 <item><widget class="QCheckBox" name="chkCalAutoUpdate"><property name="text"><string>Авто-обновл. коэфф.</string></property><property name="toolTip"><string>После каждого цикла записать новые коэффициенты в прибор (текущий←новый).</string></property></widget></item>
                 <item><spacer name="speedCalCfgSpacer"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>10</width><height>10</height></size></property></spacer></item>
                </layout>
               </item>
               <item>
                <layout class="QHBoxLayout" name="speedCalBtnRow">
                 <item><widget class="QCheckBox" name="chkSpeedCalAll"><property name="text"><string>Все</string></property><property name="checked"><bool>true</bool></property><property name="toolTip"><string>Выбрать/снять все скорости для прогона калибровки.</string></property></widget></item>
                 <item><widget class="QPushButton" name="btnSpeedCalAuto"><property name="text"><string>Калибровать</string></property><property name="toolTip"><string>Автопроход стенда по ОТМЕЧЕННЫМ скоростям: на каждой задаёт скорость, опрашивает гироскоп и заполняет «Измерено».</string></property></widget></item>
                 <item><widget class="QPushButton" name="btnSpeedCalRead"><property name="text"><string>Прочитать</string></property></widget></item>
                 <item><widget class="QPushButton" name="btnSpeedCalDefault"><property name="text"><string>Дефолт</string></property></widget></item>
                 <item><widget class="QPushButton" name="btnSpeedCalWrite"><property name="text"><string>Записать</string></property></widget></item>
                </layout>
               </item>
              </layout>
             </widget>
            </item>
            <item row="1" column="0">
             <widget class="QGroupBox" name="groupCalibGps">
              <property name="title"><string>Калибровка по GPS-PPS</string></property>
              <layout class="QVBoxLayout" name="calibGpsLayout">
               <item><widget class="QLabel" name="lblCalibGps"><property name="text"><string>В разработке: суб-ppm калибровка часов по секундной метке GPS-PPS (вывод RTC_CALIB сервисного разъёма).</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
              </layout>
             </widget>
            </item>
         </layout>
        </item>
       </layout>
      </widget>

      <widget class="QWidget" name="tabFlashStm">
       <attribute name="title"><string>FLASH STM</string></attribute>
       <layout class="QVBoxLayout" name="flashStmLayout">
        <item>
         <widget class="QGroupBox" name="groupDevInfo">
          <property name="title"><string>Паспорт прибора (внутр. Flash STM32, стр.123)</string></property>
          <layout class="QHBoxLayout" name="devInfoLayout">
           <!-- Порядок: № — Дата — Тип, дальше кнопки (06.08.2026).
                «Тип» БЕЗ выбора: вариант прибор сообщает сам по WHO_AM_I
                датчика, руками его задавать нечего. Ширины заданы явно —
                иначе длинный серийник прокручивался и был виден хвост. -->
           <item><widget class="QLabel" name="lblSerialCap"><property name="text"><string>№</string></property></widget></item>
           <item><widget class="QLineEdit" name="editSerial"><property name="text"><string/></property><property name="minimumWidth"><number>120</number></property><property name="maximumWidth"><number>150</number></property><property name="placeholderText"><string>серийный</string></property></widget></item>
           <!-- Версия ПО прибора рядом с номером (06.08.2026): её надо видеть
                при паспортизации, чтобы не записать прибор с чужой прошивкой.
                Только показ — приходит от прибора по WHO_AM_I. -->
           <item><widget class="QLabel" name="lblFwVerCap"><property name="text"><string>Версия</string></property></widget></item>
           <item><widget class="QLineEdit" name="editFwVer"><property name="readOnly"><bool>true</bool></property><property name="minimumWidth"><number>140</number></property><property name="maximumWidth"><number>170</number></property><property name="placeholderText"><string>версия прибора</string></property><property name="toolTip"><string>Версия прошивки прибора (ГГ.ММ.ДД ЧЧ.ММ) — приходит по WHO_AM_I</string></property></widget></item>

           <!-- Реестр приборов (06.08.2026): номер выдаёт программа, оператор
                подтверждает. Следующий свободный — первый незанятый в index.txt. -->
           <item><widget class="QPushButton" name="btnSerialNext"><property name="text"><string>Следующий №</string></property><property name="toolTip"><string>Подставить следующий свободный номер из реестра и сегодняшнюю дату</string></property></widget></item>
           <item><widget class="QPushButton" name="btnDevInfoRead"><property name="text"><string>Прочитать</string></property></widget></item>
           <item><widget class="QPushButton" name="btnDevInfoWrite"><property name="text"><string>Записать</string></property></widget></item>
           <item><widget class="QPushButton" name="btnRegistryOpen"><property name="text"><string>Реестр…</string></property><property name="toolTip"><string>Открыть папку реестра приборов</string></property></widget></item>
          </layout>
         </widget>
        </item>
        <item>
         <layout class="QHBoxLayout" name="flashStmColumns">
          <item>
           <layout class="QVBoxLayout" name="flashStmColLeft">
            <item>
             <widget class="QGroupBox" name="groupJournals">
              <property name="title"><string>Журналы и обслуживание (внутр. Flash STM32)</string></property>
              <layout class="QVBoxLayout" name="journalsLayout">
               <item>
                <layout class="QHBoxLayout" name="actStateRow">
                 <item><widget class="QLabel" name="lblActStateCap"><property name="text"><string>Состояние:</string></property></widget></item>
                 <item><widget class="QLabel" name="lblActState"><property name="text"><string> </string></property></widget></item>
                 <item><spacer name="actStateSpacer"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>10</width><height>10</height></size></property></spacer></item>
                </layout>
               </item>
               <item>
                <layout class="QHBoxLayout" name="actTsRow">
                 <item><widget class="QLabel" name="lblActTsCap"><property name="text"><string>Активирован:</string></property></widget></item>
                 <item><widget class="QLabel" name="lblActTs"><property name="text"><string> </string></property></widget></item>
                 <item><spacer name="actTsSpacer"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>10</width><height>10</height></size></property></spacer></item>
                </layout>
               </item>
               <item>
                <layout class="QHBoxLayout" name="actCountRow">
                 <item><widget class="QLabel" name="lblActCountCap"><property name="text"><string>Активаций («жизней»):</string></property></widget></item>
                 <item><widget class="QLabel" name="lblActCount"><property name="text"><string> </string></property></widget></item>
                 <item><spacer name="actCountSpacer"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>10</width><height>10</height></size></property></spacer></item>
                </layout>
               </item>
               <item><widget class="QPushButton" name="btnClearJournals"><property name="text"><string>Очистить журналы</string></property></widget></item>
              </layout>
             </widget>
            </item>
            <item>
             <widget class="QGroupBox" name="groupActHistory">
              <property name="title"><string>История активаций</string></property>
              <layout class="QVBoxLayout" name="actHistoryLayout">
               <item><widget class="QPlainTextEdit" name="actHistory"><property name="readOnly"><bool>true</bool></property><property name="font"><font><family>Consolas</family></font></property><property name="lineWrapMode"><enum>QPlainTextEdit::NoWrap</enum></property><property name="plainText"><string>Список меток времени прошлых активаций (стр.121). Обновляется при открытии вкладки.</string></property></widget></item>
              </layout>
             </widget>
            </item>
           </layout>
          </item>
          <item>
           <layout class="QVBoxLayout" name="flashStmColRight">
            <item>
             <widget class="QGroupBox" name="groupFwUpdate">
              <property name="title"><string>Обновление ПО STM32 (по сервисному UART)</string></property>
              <layout class="QVBoxLayout" name="fwUpdateLayout">
               <item>
                <layout class="QHBoxLayout" name="fwFileRow">
                 <item><widget class="QLineEdit" name="editFwFile"><property name="readOnly"><bool>true</bool></property><property name="placeholderText"><string>Файл прошивки (.bin)…</string></property></widget></item>
                 <item><widget class="QPushButton" name="btnFwBrowse"><property name="text"><string>Обзор…</string></property></widget></item>
                </layout>
               </item>
               <item><widget class="QProgressBar" name="barFwUpdate"><property name="value"><number>0</number></property></widget></item>
               <item><widget class="QLabel" name="lblFwUpdateNote"><property name="text"><string>Прибор уйдёт в загрузчик, примет образ и сам сверит CRC. Обрыв не опасен: прибор останется в загрузчике, залейте заново.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
               <item><widget class="QPushButton" name="btnFwUpdate"><property name="text"><string>Прошить</string></property></widget></item>
              </layout>
             </widget>
            </item>
            <item>
             <spacer name="flashStmRightSpacer">
              <property name="orientation"><enum>Qt::Vertical</enum></property>
              <property name="sizeHint" stdset="0"><size><width>20</width><height>40</height></size></property>
             </spacer>
            </item>
           </layout>
          </item>
         </layout>
        </item>
        <!-- Чтение внутренней Flash STM32 (05.08.2026). Занимает место бывшего
             распорки внизу вкладки: окно нужно широкое, гекс-строка длинная.
             ⚠ Не путать с «Тестом памяти» — тот читает ВНЕШНИЙ NOR (чип данных,
             страница 256 Б). Здесь внутренняя память МК: страница 2 КБ, в ней
             код, паспорт, калибровки, журналы и секция загрузчика. -->
        <item>
         <widget class="QGroupBox" name="groupIflashRead">
          <property name="title"><string>Внутренняя Flash STM32 — чтение (страница 2 КБ)</string></property>
          <layout class="QVBoxLayout" name="iflashLayout">
           <item>
            <layout class="QHBoxLayout" name="iflashCtlRow">
             <item><widget class="QLabel" name="lblIflashPageCap"><property name="text"><string>Страница</string></property></widget></item>
             <item>
              <widget class="QSpinBox" name="spinIflashPage">
               <property name="minimum"><number>0</number></property>
               <property name="maximum"><number>127</number></property>
               <property name="value"><number>113</number></property>
               <property name="buttonSymbols"><enum>QAbstractSpinBox::NoButtons</enum></property>
               <property name="minimumWidth"><number>60</number></property>
              </widget>
             </item>
             <item><widget class="QPushButton" name="btnIflashRead"><property name="text"><string>Прочитать</string></property></widget></item>
             <item><widget class="QLabel" name="lblIflashAddr"><property name="text"><string> </string></property></widget></item>
             <item><spacer name="iflashCtlSpacer"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>10</height></size></property></spacer></item>
             <item><widget class="QPushButton" name="btnIflashBoot"><property name="text"><string>загрузчик 113</string></property></widget></item>
             <item><widget class="QPushButton" name="btnIflashAct"><property name="text"><string>активации 121</string></property></widget></item>
             <item><widget class="QPushButton" name="btnIflashCfg"><property name="text"><string>паспорт 123</string></property></widget></item>
             <item><widget class="QPushButton" name="btnIflashJrn"><property name="text"><string>рестарты 124</string></property></widget></item>
            </layout>
           </item>
           <item>
            <widget class="QPlainTextEdit" name="iflashDump">
             <property name="readOnly"><bool>true</bool></property>
             <property name="lineWrapMode"><enum>QPlainTextEdit::NoWrap</enum></property>
             <property name="minimumHeight"><number>220</number></property>
             <property name="font"><font><family>Consolas</family><pointsize>9</pointsize></font></property>
            </widget>
           </item>
          </layout>
         </widget>
        </item>
       </layout>
      </widget>

     </widget>
    </item>
   </layout>
  </widget>

  <!-- ===== МЕНЮ ===== -->
  <widget class="QMenuBar" name="menubar">
   <widget class="QMenu" name="menuHelp">
    <property name="title"><string>Помощь</string></property>
    <addaction name="actSaveJournal"/>
    <addaction name="separator"/>
    <addaction name="actExit"/>
    <addaction name="actAbout"/>
   </widget>
   <addaction name="actGoData"/>
   <addaction name="menuHelp"/>
  </widget>
  <widget class="QStatusBar" name="statusbar"/>

  <action name="actSaveJournal">
   <property name="text"><string>Сохранить журнал…</string></property>
  </action>
  <action name="actExit">
   <property name="text"><string>Выход</string></property>
  </action>
  <action name="actGoData">
   <property name="text"><string>Данные</string></property>
   <property name="checkable"><bool>true</bool></property>
   <property name="checked"><bool>true</bool></property>
  </action>
  <action name="actEngineerMode">
   <property name="text"><string>Сервис</string></property>
   <property name="checkable"><bool>true</bool></property>
  </action>
  <action name="actAbout">
   <property name="text"><string>О программе</string></property>
  </action>
 </widget>

