		<item row="4" column="2" colspan="2"><widget class="QLabel" name="lblPauseCap"><property name="alignment"><set>Qt::AlignLeft|Qt::AlignVCenter</set></property><property name="text"><string>Время простоя</string></property></widget></item>

			<item row="5" column="0" colspan="2"><widget class="QLabel" name="lblPauseMinCap"><property name="alignment"><set>Qt::AlignRight|Qt::AlignVCenter</set></property><property name="styleSheet"><string>padding-right: 8px;</string></property><property name="text"><string>Минимум</string></property></widget></item>
